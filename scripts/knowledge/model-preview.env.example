# Template only. Fill a private copy, never this tracked example.
# Suggested private path: tmp/company-knowledge-model/.env (ignored by Git).
# Ask the person who manages the company's AI provider to supply these values.
LLM_COMMENT_API_KEY=
# API base URL without /chat/completions; blank uses the existing OpenAI default.
LLM_COMMENT_BASE_URL=
# Use the company's configured model name; blank uses the app default.
OPENAI_COMMENT_MODEL=
